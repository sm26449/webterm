# Authentik de PRODUCŢIE (docker-compose.prod.yml). Copiază în `.env` şi completează.
# Secretele: openssl rand -base64 48

# Subdomeniul pe care va răspunde Authentik (are nevoie de un DNS A/AAAA către acest host).
# Traefik-ul WebTerm obţine automat certificatul TLS pentru el.
AUTHENTIK_DOMAIN=auth.example.com

# Secretele Authentik.
AUTHENTIK_SECRET_KEY=
PG_PASS=
# Parola adminului iniţial (user: akadmin), creat la prima pornire.
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Token de API pentru provisioning automat (./provision.sh). Lasă gol dacă provisionezi manual;
# provision.sh poate genera oricum unul nou prin `ak shell`.
AUTHENTIK_BOOTSTRAP_TOKEN=

# Resolverul TLS: `le` (HTTP-01, implicit) sau `ledns` (Cloudflare DNS-01). Pune aceeaşi valoare
# ca în .env-ul WebTerm (o scrie install.sh/deploy.sh acolo). Cu `le` e nevoie ca portul 80 să fie
# accesibil public pentru subdomeniu; cu `ledns` nu, dar Traefik-ul WebTerm trebuie să aibă
# CF_DNS_API_TOKEN setat.
WEBTERM_CERT_RESOLVER=le

# Reţeaua Traefik a stack-ului WebTerm = <proiect>_<reţea>. Implicit WebTerm stă în /opt/webterm,
# deci proiectul e `webterm` şi reţeaua `webterm_webterm`. Schimb-o doar dacă ai instalat în alt loc
# (numele proiectului = numele directorului). Verifică cu: docker network ls | grep webterm
WEBTERM_TRAEFIK_NETWORK=webterm_webterm

# Folosite de ./provision.sh ca să creeze aplicaţia OIDC şi să seteze redirect URI-ul corect.
# WEBTERM_DOMAIN = domeniul instanţei WebTerm pe care o legi (redirect: https://<el>/api/oidc/callback).
WEBTERM_DOMAIN=term.example.com
# Numele afişat pe butonul din pagina de login WebTerm.
WEBTERM_OIDC_PROVIDER_NAME=Authentik
