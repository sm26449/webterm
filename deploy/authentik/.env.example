# Copiază în `.env` şi completează. Secretele: generează cu `openssl rand -base64 48`.
PG_PASS=
AUTHENTIK_SECRET_KEY=
# Parola adminului Authentik iniţial (user: akadmin), creat la prima pornire.
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Opţional: un token de API pentru automatizare (blueprints/scripturi). Poţi lăsa gol.
AUTHENTIK_BOOTSTRAP_TOKEN=

# WebTerm — trebuie să corespundă cu ce e în blueprints/webterm.yaml.
WEBTERM_PUBLIC_URL=http://localhost:8000
WEBTERM_SETUP_TOKEN=changeme-setup
WEBTERM_OIDC_ISSUER=http://authentik-server:9000/application/o/webterm/
WEBTERM_OIDC_CLIENT_ID=webterm-client-id
WEBTERM_OIDC_CLIENT_SECRET=webterm-client-secret
WEBTERM_OIDC_PROVIDER_NAME=Authentik
WEBTERM_OIDC_ALLOWED_GROUPS=
# Imaginea WebTerm (implicit ultima publicată).
#WEBTERM_IMAGE=ghcr.io/sm26449/webterm:v2.0.19
