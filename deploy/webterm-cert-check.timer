[Unit]
Description=WebTerm — verificare zilnică a certificatului TLS

[Timer]
OnCalendar=*-*-* 07:15:00
# rulează verificarea și dacă serverul era oprit la ora programată.
# ATENŢIE: systemd NU suportă comentarii pe aceeaşi linie — un `Persistent=true  # ...`
# e respins cu „Failed to parse boolean value, ignoring" şi cade pe false, tăcut.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
