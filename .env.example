# WebTerm — configuration. Copy to `.env` and fill it in.
# docker compose reads this file automatically.

# The application's public URL (used by the browser, by agents and by WebAuthn).
# With a domain:  https://term.example.com
# With an IP / for testing:  https://192.168.1.10
WEBTERM_PUBLIC_URL=https://term.example.com

# The domain for Caddy's TLS certificate (Let's Encrypt, automatic).
# Use the same host as in WEBTERM_PUBLIC_URL (domain or IP).
WEBTERM_DOMAIN=term.example.com

# Set to 1 ONLY when reaching the app by IP (self-signed certificate).
# With a real domain, leave it empty.
WEBTERM_AGENT_INSECURE=

# Setup token for the first account. Leave it empty and one is generated at
# first boot and printed to the logs (docker compose logs app).
WEBTERM_SETUP_TOKEN=

# Backlog per browser before a resync (bytes). Default 1 MiB.
# WEBTERM_CLIENT_BUFFER=1048576
