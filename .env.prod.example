# Production configuration. Copy to `.env` and fill it in.
# deploy.sh generates the setup token automatically if you leave it empty.

# The public domain (DNS A/AAAA record → this server). Without it Let's Encrypt cannot issue the certificate.
WEBTERM_DOMAIN=term.example.com

# Email for Let's Encrypt (expiry notices only).
LETSENCRYPT_EMAIL=you@example.com

# Cloudflare token — OPTIONAL. Leave it empty and Let's Encrypt uses HTTP-01, which needs
# no DNS provider at all: just this domain resolving here and port 80 reachable.
#
# Set it when you are behind the Cloudflare proxy or behind NAT without port 80 — and when
# you use port forwarding: forward subdomains are matched by a pattern, so only a WILDCARD
# certificate covers them — and only DNS-01 can issue one. On HTTP-01 the app gets TLS
# normally, but forwards do not.
#
# Create it in Cloudflare → My Profile → API Tokens → Create Token:
#   permission  Zone : DNS : Edit
#   scope       Include → Specific zone → your domain
CF_DNS_API_TOKEN=

# Written by install.sh/deploy.sh from the answer above — do not set by hand.
#WEBTERM_CERT_RESOLVER=le
#WEBTERM_CERT_LABEL_MAIN=
#WEBTERM_CERT_LABEL_SANS=
#WEBTERM_CERT_LABEL_FWD_MAIN=
#WEBTERM_CERT_LABEL_FWD_SANS=

# The setup token: the gate on creating the first account (keeps bots from claiming it).
# Leave empty → deploy.sh generates one and writes it here.
WEBTERM_SETUP_TOKEN=

# The image, pinned to a released version. `:latest` used to be the default here, which meant
# a fresh install ran whatever the registry pointed at that minute — and `.prev-image` (the
# rollback breadcrumb `deploy.sh` writes) recorded a moving pointer, so "roll back" had nothing
# to roll back to. `upgrade.sh` already refuses to pin `:latest` without `--allow-latest`;
# the install path now agrees with it. Upgrade with `./upgrade.sh vX.Y.Z`, not by editing this.
WEBTERM_IMAGE=ghcr.io/sm26449/webterm:v2.0.2

# PUBLIC image → pull needs no authentication; leave the lines below commented out.
# Only for a PRIVATE image / fork: a classic token with the `read:packages` scope.
#GHCR_USER=sm26449
#GHCR_TOKEN_FILE=/path/to/ghcr_token.txt

# ── Security: email alerts (optional) ────────────────────────────────────────
# With no SMTP host the alerts are off (everything else works normally).
# It sends: an IP blocked after failed attempts (throttled) and a successful login
# from a new IP. It does NOT send one email per attempt (that would be a mail-bombing vector).
#WEBTERM_SMTP_HOST=smtp.example.com
#WEBTERM_SMTP_PORT=587
#WEBTERM_SMTP_USER=alerts@example.com
#WEBTERM_SMTP_PASSWORD=
#WEBTERM_SMTP_STARTTLS=1
#WEBTERM_ALERT_FROM=alerts@example.com
#WEBTERM_ALERT_TO=admin@example.com      # the address that receives the alerts

# How many failed attempts per IP before a temporary block (default 5).
#WEBTERM_IP_MAX_FAILS=5

# Who is allowed to set X-Forwarded-For (the real IP matters for lockout/rate-limiting).
# Default: any peer on a private network / loopback. If the app is also reachable from other
# parts of your internal network, narrow this to your proxy's CIDR:
#WEBTERM_TRUSTED_PROXY_CIDRS=172.18.0.0/16
# How many proxies sit in front. The real client IP is read that many hops from the RIGHT of
# X-Forwarded-For, so this must match reality or the lockout counts the PROXY's IP and every
# client shares one bucket. Traefik alone = 1 (the default). Cloudflare in front of Traefik = 2.
#WEBTERM_TRUSTED_PROXY_HOPS=2

# The "is there a new version?" check — one GET to api.github.com, at most once
# a day, plus the "check now" button in Settings. It sends nothing about your instance.
# It is the only connection the gateway initiates outward on its own; you can turn it
# off here (this overrides the switch in Settings) or from the UI.
#WEBTERM_UPDATE_CHECK=0
# Only while the repo is private: a fine-grained read-only token (Contents: Read). On a
# public repo nothing is needed — the check works with no secret at all, which is
# preferable: a token in the gateway reaches anyone who reaches the gateway.
#WEBTERM_UPDATE_CHECK_TOKEN=
# The command the UI DISPLAYS when a new version exists (it never runs it).
# Change it if WebTerm does not live in /opt/webterm. `{version}` = the tag found.
#WEBTERM_UPDATE_COMMAND=cd /opt/webterm && sudo ./upgrade.sh {version}
