{
	# when reached by IP the browser sends no SNI; serve the site's certificate
	default_sni {$WEBTERM_DOMAIN}
}

# Only the application's own domain is served here. Port-forward subdomains
# (`<slug>.<domain>`) are NOT routed on this path, on purpose: they need a WILDCARD
# certificate, which only a DNS-01 challenge can issue, and the stock `caddy:2-alpine`
# image ships no DNS provider module (and Caddy's on-demand TLS would need an `ask`
# endpoint to avoid issuing certificates for arbitrary names). The UI still shows the
# forward button; on this stack it will not get a certificate. Forwards are supported
# on the Traefik stack (`docker-compose.prod.yml` + a Cloudflare token) — see
# docs/PORT-FORWARDING.md "Deploy". If you must stay on Caddy, build an image with
# `caddy-dns/cloudflare` and add a `*.{$WEBTERM_DOMAIN}` block with `tls { dns … }`.
{$WEBTERM_DOMAIN} {
	reverse_proxy app:8000

	header {
		# HSTS is TLS-specific (the rest of the security headers come from the app)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	# Pre-auth routes carry only tiny JSON / WebAuthn assertions (credentials, a 6-digit
	# code), so cap them hard at the edge: a large pre-auth body is rejected before it ever
	# reaches the app (the backend keeps its own app-level cap too). 256KB is generous for any
	# login/setup/WebAuthn/OIDC payload yet closes the unauthenticated memory-amplification path.
	@preauth path /api/login /api/setup /api/webauthn/* /api/oidc/*
	request_body @preauth {
		max_size 256KB
	}
	# request body size limit for everything else (uploads through the agent have their own path)
	request_body {
		max_size 5GB
	}
}
